{
  "rpcUrl": "http://127.0.0.1:13134",
  "chainId": 12315,
  "rpcTimeoutMs": 2000,
  "dryRunStartNonce": 0,
  "privateKey": "0x8fc570d5311a0ac6b72e7996a6f0cf473b1765518fe7b8a76612782c062507fa",
  "from": "0x755Ccf704E17570b64E247f0794314e4C8E542CA",
  "reportFile": "./tx_config_fun_eth_all_types_report.json",
  "defaults": {
    "gasLimit": "3000000",
    "maxFeePerGasGwei": "1",
    "maxPriorityFeePerGasGwei": "0.5",
    "pollIntervalMs": 3000,
    "receiptTimeoutMs": 120000,
    "stripTransferJsonAmount": true,
    "continueOnError": false
  },
  "common": {
    "recipient": "0x000000000000000000000000000000000000dEaD",
    "validator": "0x000000000000000000000000000000000000dEaD",
    "assetType": "OHI",
    "stakeUtxoHash": "0xCHANGE_ME_STAKE_UTXO_HASH",
    "delegatingUtxoHash": "0xCHANGE_ME_DELEGATING_UTXO_HASH",
    "lockUtxoHash": "0xCHANGE_ME_LOCK_UTXO_HASH",
    "voteHash": "0xCHANGE_ME_VOTE_OR_PROPOSAL_HASH"
  },
  "transactions": [
    {
      "name": "tx: custom JSON OHI transfer, amount from raw tx value",
      "saveAs": "txTransfer",
      "to": "$config.common.recipient",
      "valueEth": "0.00000001",
      "jsonData": {
        "type": "tx",
        "asset_type": "$config.common.assetType",
        "is_find_utxo": false,
        "sponsor_gas": false,
        "encoded_info": "fun_eth tx transfer"
      }
    },
    {
      "name": "transaction alias: custom JSON OHI transfer",
      "enabled": false,
      "reason": "alias test; enable when you want to send a second transfer",
      "saveAs": "transactionAliasTransfer",
      "to": "$config.common.recipient",
      "valueEth": "0.00000001",
      "jsonData": {
        "type": "transaction",
        "asset_type": "$config.common.assetType",
        "amount": "THIS_FIELD_WILL_BE_STRIPPED",
        "is_find_utxo": false,
        "sponsor_gas": false,
        "encoded_info": "fun_eth transaction alias transfer"
      }
    },
    {
      "name": "stake: create stake transaction",
      "enabled": false,
      "reason": "enable only when the sender has enough spendable OHI and should really stake",
      "saveAs": "stake",
      "to": "$config.common.recipient",
      "valueWei": "0",
      "jsonData": {
        "type": "stake",
        "asset_type": "$config.common.assetType",
        "amount": "1000000",
        "reward_rank": "10",
        "is_find_utxo": false,
        "sponsor_gas": false,
        "encoded_info": "fun_eth stake"
      }
    },
    {
      "name": "unstake: withdraw stake by stake_utxo_hash",
      "enabled": false,
      "reason": "replace common.stakeUtxoHash with a real stake UTXO before enabling",
      "saveAs": "unstake",
      "to": "$config.common.recipient",
      "valueWei": "0",
      "jsonData": {
        "type": "unstake",
        "asset_type": "$config.common.assetType",
        "stake_utxo_hash": "$config.common.stakeUtxoHash",
        "is_find_utxo": false,
        "sponsor_gas": false,
        "encoded_info": "fun_eth unstake"
      }
    },
    {
      "name": "delegating: delegate to raw tx to address",
      "enabled": false,
      "reason": "enable only when validator address and amount are correct",
      "saveAs": "delegating",
      "to": "$config.common.validator",
      "valueWei": "0",
      "jsonData": {
        "type": "delegating",
        "asset_type": "$config.common.assetType",
