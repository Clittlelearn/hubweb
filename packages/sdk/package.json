      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "utils",
    "typescript"
  ],
  "dependencies": {
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
