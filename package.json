{
  "name": "openhive-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev -- --host 0.0.0.0 --port 5174 --strictPort",
    "preview:static": "npx serve -s dist -l 3000",
    "build:sdk": "npm run build --workspace=@openhive/sdk",
    "build": "npm run build:sdk && vite build",
    "dev": "npm run build:sdk && vite",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "postinstall": "npm run build:sdk"
  },
  "dependencies": {
    "@openhive/sdk": "0.1.0",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@tanstack/react-query": "^5.95.2",
    "bignumber.js": "^10.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "^1.11.20",
    "ethers": "^6.16.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.13.0",
    "recharts": "2.15.2",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "viem": "^2.47.6",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
